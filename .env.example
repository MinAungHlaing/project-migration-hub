# The local admin preview works with no .env file and no database.
VITE_LOCAL_DEMO=true

# Optional live-backend settings. To use these, set VITE_LOCAL_DEMO=false
# and fill in values for your own Supabase development project.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
